<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[globals [
  next-group-id
  total-left-group
  total-rejoined-group
  total-convincing-attempts
  total-convincing-failures
  total-group-following
  total-departures
  total-rejoins
  total-disagreements
  total-convince-attempts
  succesful-convince-attempts
  cumulative-percent-in-group
  measurement-ticks
  total-completed-solo-time
  completed-solo-trips
  food-choice-count
  drinks-choice-count
  stage-choice-count
  toilet-choice-count
  total-destination-choices
]

patches-own [ 
  obstacle? 
  target-type ]

turtles-own [ 
  food-level
  drinks-level
  toilet-level
  stage-level
  personal-food-increase
  personal-drinks-increase
  personal-toilet-increase
  personal-stage-increase
  target
  wait-time
  wandering?
  wandering-time
  group-id
  home-group-id
  returning-to-group?
  own-target
  group-agrees?
  leader?
  identity-type
  identification-strength
  wants-to-leave?
  decision-state
  current-solo-time
  disagreement-counted?
  previous-own-target-type] 

to setup
  clear-all
  apply-destination-scenario
  set next-group-id 0
  set total-left-group 0
  set total-rejoined-group 0
  set total-convincing-attempts 0
  set total-convincing-failures 0
  set total-group-following 0
  set total-departures 0
  set total-rejoins 0
  set total-disagreements 0
  set total-convince-attempts 0
  set succesful-convince-attempts 0
  set cumulative-percent-in-group 0
  set measurement-ticks 0
  set total-completed-solo-time 0
  set completed-solo-trips 0
  set food-choice-count 0
  set drinks-choice-count 0
  set stage-choice-count 0
  set toilet-choice-count 0
  set total-destination-choices 0
  if new-seed? [ set current-seed new-seed ]
  random-seed current-seed
  setup-patches
  agents
  assign-home-groups
  reset-ticks
end

to setup-patches
  setup-environment
  setup-stage
  setup-drinks
  setup-food
  setup-toilets
end

to setup-environment
   ask patches [
    set obstacle? false
    set pcolor white
    set target-type "none"
  ]
end

to setup-stage
   ;; stage , het echte podium waar de agents niet op kunnen komen
  ask patches with  [pxcor > -5 and pxcor < 5 and pycor > 13 and pycor < 17] [
    set obstacle? true
    set pcolor black 
  ]
  ;; stage visiting area, het gebied voor het podium wat de agents bezoeken als ze naar de stage willen
  ask patches with [pxcor > -5 and pxcor < 5 and pycor > 1 and pycor < 14][
    set obstacle? false
    set pcolor grey
    set target-type "stage"
  ]
end

to setup-drinks
  ; dit is de drinks stand, hier kunnen de agents niet komen
    ask patches with  [pxcor > -17 and pxcor < -13 and pycor > -5 and pycor < 2] [
    set obstacle? true
    set pcolor black
  ]
  
    ;; drinks visiting area, dit is het gebied voor de drinks stand waar de agents naartoe gaan als ze drinken willen halen
  ask patches with [pxcor > -14 and pxcor < -9 and pycor > -5 and pycor < 2][
    set obstacle? false
    set pcolor grey
    set target-type "drinks"
  ]
end

to setup-food
  ;; Dit is de food stand, hier kunnen de agents niet komen
    ask patches with  [pxcor > -17 and pxcor < -13 and pycor > -13 and pycor < -6 ] [
    set obstacle? true
    set pcolor black
  ]
  
      ;; food visiting area, dit is het gebied bij de foodstand waar de agents naartoe gaan als ze willen eten
  ask patches with [pxcor > -14 and pxcor < -9 and pycor > -13 and pycor < -6][
    set obstacle? false
    set pcolor grey
    set target-type "foods"
  ]
end

to setup-toilets 
  ;; toilet gebied, hier gaan de agents naartoe als ze naar het toilet moeten
   ask patches with  [pxcor > 11 and pxcor < 17 and pycor > -17 and pycor < -11] [
    set obstacle? false
    set pcolor grey
    set target-type "toilets"
  ]
end

  
to go
  if ticks >= 720 [
    stop
  ]
  
  check-goal-dominance
  check-group
  convince-group
  go-without-group
  move-agents
  update-target-plot
  update-group-plot
  update-decision-plot
  update-lifecycle-plot
  update-destination-status-plot
  update-output-measures
  
  tick
 
end

to agents
  create-turtles number [
  move-to one-of patches with [not obstacle?]
  set color blue
  set food-level random food
  set drinks-level random drink
  set toilet-level random toilet
  set stage-level random stage
  set personal-food-increase food-increase * random-float 2
  set personal-drinks-increase drinks-increase * random-float 2
  set personal-toilet-increase toilet-increase * random-float 2
  set personal-stage-increase stage-increase * random-float 2
  set current-solo-time 0
  set wait-time 0
  set wandering? false
  set wandering-time 0
  set target nobody
  set own-target nobody
  set group-agrees? false
  set home-group-id -1
  set group-id -1
  set returning-to-group? false
  set leader? false
  set identity-type one-of ["stage-fan" "food-focused" "drinks-focused"]
  set wants-to-leave? false
  set identification-strength 
    max (list 0
      min (list 1
        ( identification-strength-slider + random-normal 0 0.15)))
  set decision-state "choosing"
  set disagreement-counted? false
  set previous-own-target-type "none"
  ]
end
to choose-new-target
  let possible-targets []
  
  if food-level >= food [
    set possible-targets lput (list food-level "foods") possible-targets
  ]
  
  if drinks-level >= drink [
    set possible-targets lput (list drinks-level "drinks") possible-targets
  ]
  
  if toilet-level >= toilet [
      set possible-targets lput (list toilet-level "toilets") possible-targets
    ]
  
  if stage-level >= stage [
    set possible-targets lput (list stage-level "stage") possible-targets
  ]
    
   ifelse not empty? possible-targets [
      let highest-need max map [x -> first x] possible-targets
      
   let best-targets filter
      [x -> first x = highest-need]
      possible-targets
      
    let chosen one-of best-targets
      let chosen-type last chosen
      
    set target one-of patches with [
        target-type = chosen-type and
        obstacle? = false
      ]
    ][
      
      set target one-of patches with [
        target-type = "stage" and 
        obstacle? = false
      ]
    ]
    
    if target != nobody [
      let new-target-type [target-type] of target
      
      set total-destination-choices total-destination-choices + 1
      
      if new-target-type = "foods" [
        set food-choice-count food-choice-count + 1
      ]
      
      if new-target-type = "drinks" [
        set drinks-choice-count drinks-choice-count + 1
      ]
      
      if new-target-type = "toilets" [
        set toilet-choice-count toilet-choice-count + 1
      ]
      
      if new-target-type = "stage"[
        set stage-choice-count stage-choice-count + 1
      ]
    ]
    set wandering? false
    if target != nobody [
      let new-target-type [target-type] of target
      
      if new-target-type != previous-own-target-type [
        set disagreement-counted? false
        set previous-own-target-type new-target-type
      ]
      set own-target target 
    ]
end

to assign-home-groups
  let group-number 0
  let remaining-turtles turtles
  
  while [any? remaining-turtles] [
    let this-group-size min-group-start-size + random (max-group-start-size - min-group-start-size + 1)
    if this-group-size > count remaining-turtles [
      set this-group-size count remaining-turtles
    ]
    
    let new-members n-of this-group-size remaining-turtles
    let group-leader one-of new-members
    
    ask new-members [
      set home-group-id group-number
      set group-id group-number
      set returning-to-group? false
      set leader? false
    ]
    
    ask group-leader [
      set leader? true
    ]
    
    set remaining-turtles remaining-turtles with [
      not member? self new-members
    ]
    
    set group-number group-number + 1
  ]
  
  set next-group-id group-number
end

to start-wandering
  set target nobody
  set wandering? true
  set wandering-time wandering-time-slider
end

to check-goal-dominance
  ask turtles with [
    wait-time = 0 and 
    wandering? = false and
    returning-to-group? = false
  
  ][
    set decision-state "choosing"
    choose-new-target
  ]

end

to check-group
  ask turtles with [
    group-id != -1 and
    own-target != nobody
  ] [

    let my-group-id group-id
    let my-target-type [target-type] of own-target

    let members other turtles with [
      group-id = my-group-id
    ]

    let same-target-members members with [
      own-target != nobody and
      [target-type] of own-target = my-target-type
    ]

    ifelse any? same-target-members [

      set group-agrees? true

    ][
      set group-agrees? false

      if not disagreement-counted? [
        set total-disagreements total-disagreements + 1
        set disagreement-counted? true
      ]
    ]
  ]
end


to convince-group
  ; in deze functie probeert de agent de groep te overtuigen of deze meewil naar de destination
  ask turtles with [group-id != -1 and own-target != nobody and group-agrees? = false] [
    set decision-state "convincing"
    set total-convincing-attempts total-convincing-attempts + 1

set wants-to-leave? false
set group-agrees? false

let members other turtles with [
  group-id = [group-id] of myself
]

if any? members [
  set total-convince-attempts total-convince-attempts + 1
  let convinced-members members with [
    random-float 1 < [identification-strength] of myself * convince-chance
  ]
        ifelse count convinced-members > count members / 2 [
  set group-agrees? true
  set decision-state "group-convinced"
        
  set succesful-convince-attempts
        succesful-convince-attempts + 1
  
  ask convinced-members [
          if [target-type] of target != [target-type] of [own-target] of myself [
            set total-group-following total-group-following + 1
          ]
          
    set target [own-target] of myself
    set wandering? false
    ]
  ][
  set group-agrees? false
  set wants-to-leave? true
  set decision-state "convince-failed"
  set total-convincing-failures total-convincing-failures + 1
  ]
]
]


end

to go-without-group
  ;; in deze functie beslist de agent of die alleen naar de destination wil of dat hij bij de groep wil blijven

  ask turtles with [group-id != -1 and own-target != nobody and wants-to-leave? ] [

    let current-group group-id
    let group-mates other turtles with [group-id = current-group
    ]

    if any? group-mates [
    set decision-state "deciding"
    
        let my-need max (list food-level drinks-level toilet-level stage-level)

      let current-group-size count turtles with [
        group-id = [group-id] of myself
      ]
      let personal-threshold leave-threshold +
          (identification-strength * identity-buffer) + (current-group-size * group-cohesion-strength)

      if count group-mates >= 2 [
        if my-need > personal-threshold [
          let leave-probability go-alone-chance  * ( 1 - identification-strength)
          ifelse random-float 1 < leave-probability [
            set total-left-group total-left-group + 1
            set total-departures total-departures + 1
            set current-solo-time 0
            set decision-state "going-alone"
            set group-id -1
            set returning-to-group? false
            set leader? false
            set target own-target
            set wandering? false
            set wait-time wait-time
            ;set wants-to-leave? false
          ][
            set decision-state "staying-group"
          ]
          ]
        ]
      ]
    ]

end

to return-to-home-group
  ask turtles with [group-id = -1 and returning-to-group?] [
  
 if wait-time > 0 [ 
    set wait-time wait-time - 1
    stop
  ]
  
    let my-home-group home-group-id
    
    let group-members other turtles with [
     home-group-id = my-home-group
    ]
    
    if any? group-members [
      let nearest-member min-one-of group-members [distance myself]
      
      face nearest-member
      
      ifelse distance nearest-member <= rejoin-radius [
      set total-rejoined-group total-rejoined-group + 1
        set total-rejoins total-rejoins + 1
        set total-completed-solo-time total-completed-solo-time + current-solo-time
        set completed-solo-trips completed-solo-trips + 1
        set current-solo-time 0
        set group-id home-group-id
        set returning-to-group? false
        set target nobody
        set wandering? false
        set disagreement-counted? false
        set previous-own-target-type "none"
      ][
      let next-patch patch-ahead 1
      
      ifelse next-patch != nobody
      and can-move? 1
      and not [obstacle?] of next-patch [
        fd 1
      ][
        rt random 90
    ]
    ]
    ]
  ]
end


to update-color
  ;; deze functie zorgt ervoor dat de agents hun kleur aan passen, gebaseerd op of ze deel zijn van een groep of niet
ifelse group-id != -1 [
    set color blue
  ]
  [
   set color red
  ]
end

to handle-waiting
  ; deze functie zorgt ervoor dat de wachttijd van agents die bij een destination zijn afloopt
  if wait-time > 0 [
    set wait-time wait-time - 1
  ]
end

to handle-movement
  ; deze functie zorgt ervoor dat de agents bewegen over het terrein
  move

  if not wandering? and target != nobody [
    face target
  ]

  rt random rotation - random rotation
end

to handle-behaviour-switch
  if wandering? [
    set wandering-time wandering-time - 1
  
    
    if wandering-time <= 0 [
      choose-new-target
      set wandering? false
    ]
  ]
  
  if not wandering? [
    if random 100 < wandering-chance [
      start-wandering
    ]
  ]
end

to move-forward
  ; zorgt ervoor dat de agents vooruit bewegen
  let next-patch patch-ahead 1

  ifelse next-patch != nobody
     and can-move? 1
     and not [obstacle?] of next-patch [
    fd 1
  ] [
    rt random 90
  ]
end

to update-needs
  set food-level food-level + personal-food-increase 
  set drinks-level drinks-level + personal-drinks-increase 
  set toilet-level toilet-level + personal-toilet-increase 
  set stage-level stage-level + personal-stage-increase 
end


to move
  if target != nobody and distance target < 1 [
    move-to target
    refill-level
    set-wait-time
    
    if group-id = -1 [
      set returning-to-group? true
      set target nobody 
      stop
    ]
    
    choose-new-target
   stop
  ]
end

to move-agents
  ask turtles [
    update-color
    update-needs
   
    ifelse wait-time > 0 [
      set wait-time wait-time - 1
      set decision-state "waiting"
    ][
      ifelse returning-to-group? [
        move-back-to-home-group
      ][ 
        ifelse wandering? [
          wander
        ][
          if target = nobody [
            choose-new-target
          ]
          move-to-target
      ]
      ]
    ]
  ]
end

to wander
  set wandering-time wandering-time - 1
  
  rt random rotation - random rotation
  
  let next-patch patch-ahead 1
  ifelse next-patch != nobody
  and can-move? 1
  and not [obstacle?] of next-patch [
    fd 1
  ][ 
    rt random 90
  ]
  
  if wandering-time <= 0 [
    set wandering? false
    choose-new-target
  ]
end

to move-to-target
  if target = nobody [
    choose-new-target
  ]
  
  if target != nobody [
    ifelse distance target < 1 [
      move-to target
      refill-level
      set-wait-time
      
      
      ifelse group-id = -1 [
        set-wait-time 
        set returning-to-group? true
        set target nobody
      ][
        set-wait-time
        choose-new-target
      ]
    ][
      face target
      rt random rotation - random rotation
      
      let next-patch patch-ahead 1
      
      ifelse next-patch != nobody
      and can-move? 1
      and not [ obstacle?] of next-patch [
        fd 1
      ][
        rt random 90
      ]
    ]
  ]
end

to move-back-to-home-group
  set decision-state "returning"
  let my-home-group home-group-id
  
  let group-members other turtles with [
    home-group-id = my-home-group
  ]
  
  ifelse any? group-members [
    let nearest-member min-one-of group-members [distance myself]
    
    ifelse distance nearest-member <= rejoin-radius [
     set total-rejoins total-rejoins + 1
      set total-completed-solo-time total-completed-solo-time + current-solo-time
      set completed-solo-trips completed-solo-trips + 1
      set current-solo-time 0
      set group-id home-group-id
      set decision-state "rejoined"
      set total-rejoined-group total-rejoined-group + 1
      set returning-to-group? false
      set target nobody
      set wandering? false
      set wait-time 0
    ][
     face nearest-member
     
      let next-patch patch-ahead 1
      
      ifelse next-patch != nobody
      and can-move? 1
      and not [obstacle?] of next-patch [
        fd 1
      ][
        rt random 90
      ]
    ]
  ][ 
    set returning-to-group? false
    set group-id -1
    choose-new-target
  ]
end

to refill-level ;; hier worden de levels van de benodigdheden gereset als een agent naar het betreffende gebied is geweest
  if [target-type] of patch-here = "foods" [
    set food-level 0
  ]
  
  if [target-type] of patch-here = "drinks" [
    set drinks-level 0
  ]
  
  if [target-type] of patch-here = "toilets" [
    set toilet-level 0 
  ]
  
    if [target-type] of patch-here = "stage" [
      set stage-level 0
  ]
end

to set-wait-time ;; hier is een wachttijd zodat de agent niet direct weer weggaat als hij naar een target is gegaa
  if [target-type] of patch-here = "foods" [
    set wait-time food-wait
  ]
  
  if [target-type] of patch-here = "drinks" [
    set wait-time drinks-wait
  ]
  
  if [target-type] of patch-here = "toilets" [
  set wait-time toilet-wait
  ]
    
   if [target-type] of patch-here = "stage" [
  set wait-time stage-wait
  ]
end


to update-target-plot ; code voor de target choices plot
  set-current-plot "Target choices"

  set-current-plot-pen "stage"
  plot count turtles with [
    target != nobody and [target-type] of target = "stage"
  ]

  set-current-plot-pen "drinks"
  plot count turtles with [
    target != nobody and [target-type] of target = "drinks"
  ]

  set-current-plot-pen "foods"
  plot count turtles with [
    target != nobody and [target-type] of target = "foods"
  ]

  set-current-plot-pen "toilets"
  plot count turtles with [
    target != nobody and [target-type] of target = "toilets"
  ]
end

to update-group-plot ; code voor de group plot
  set-current-plot "group membership"
  
  set-current-plot-pen "in-group"
  plot count turtles with [group-id != -1]
  
  set-current-plot-pen "outside-group"
  plot count turtles with [group-id = -1]
end

to-report group-size
  report count turtles with [group-id = [group-id] of myself]
end

to update-decision-plot
  set-current-plot "Decision states"
  
  set-current-plot-pen "choosing"
  plot count turtles with [decision-state = "choosing"]

  set-current-plot-pen "convincing"
  plot count turtles with [decision-state = "convincing"]

  set-current-plot-pen "failed"
  plot count turtles with [decision-state = "convince-failed"]

  set-current-plot-pen "deciding"
  plot count turtles with [decision-state = "deciding"]

  set-current-plot-pen "alone"
  plot count turtles with [decision-state = "going-alone"]

  set-current-plot-pen "staying"
  plot count turtles with [decision-state = "staying-group"]

  set-current-plot-pen "returning"
  plot count turtles with [decision-state = "returning"]
end

to update-lifecycle-plot
  set-current-plot "group lifecycle"
  
  set-current-plot-pen "convincing"
  plot total-convincing-attempts
  
  set-current-plot-pen "failed"
  plot total-convincing-failures
  
  set-current-plot-pen "left"
  plot total-left-group
  
  set-current-plot-pen "rejoined"
  plot total-rejoined-group
end

to update-destination-status-plot
  set-current-plot "Destination by status"

  set-current-plot-pen "group-stage"
  plot count turtles with [
    group-id != -1 and target != nobody and [target-type] of target = "stage"
  ]

  set-current-plot-pen "alone-stage"
  plot count turtles with [
    group-id = -1 and target != nobody and [target-type] of target = "stage"
  ]

  set-current-plot-pen "group-drinks"
  plot count turtles with [
    group-id != -1 and target != nobody and [target-type] of target = "drinks"
  ]

  set-current-plot-pen "alone-drinks"
  plot count turtles with [
    group-id = -1 and target != nobody and [target-type] of target = "drinks"
  ]

  set-current-plot-pen "group-food"
  plot count turtles with [
    group-id != -1 and target != nobody and [target-type] of target = "foods"
  ]

  set-current-plot-pen "alone-food"
  plot count turtles with [
    group-id = -1 and target != nobody and [target-type] of target = "foods"
  ]

  set-current-plot-pen "group-toilets"
  plot count turtles with [
    group-id != -1 and target != nobody and [target-type] of target = "toilets"
  ]

  set-current-plot-pen "alone-toilets"
  plot count turtles with [
    group-id = -1 and target != nobody and [target-type] of target = "toilets"
  ]
end
to update-output-measures
  if any? turtles [
    set cumulative-percent-in-group
    cumulative-percent-in-group + (100 * count turtles with [group-id != -1] / count turtles)
    
    set measurement-ticks measurement-ticks + 1
  ]
  ask turtles with [group-id = -1][
    set current-solo-time current-solo-time + 1
  ]
end

to-report mean-percent-in-group
  if measurement-ticks = 0 [
    report 0
  ]
  report cumulative-percent-in-group / measurement-ticks
end

to-report number-of-departures
  report total-departures
end

to-report mean-time-outside-group
  if completed-solo-trips = 0 [
    report 0
  ]
  report total-completed-solo-time / completed-solo-trips
end

to-report mean-time-outside-including-unfinished
  let total-solo-time
  total-completed-solo-time + sum [current-solo-time] of turtles with [group-id = -1]
  
  let total-solo-episodes
  completed-solo-trips + sum [current-solo-time] of turtles with [group-id = -1 and current-solo-time > 0
  ]
  
  if total-solo-episodes = 0 [
    report 0
  ]
  
  report total-solo-time / total-solo-episodes
end
  

to-report rejoin-percentage
  if total-departures = 0 [
    report 0
  ]
  report 100 * total-rejoins / total-departures
end

to-report number-of-disagreements
  report total-disagreements
end

to-report departure-per-disagreement
  if total-disagreements = 0 [
    report 0
  ]
  
  report total-departures / total-disagreements
end

to-report succesful-convince-percentage
  if total-convince-attempts = 0 [
    report 0
  ]
  
  report 100 * succesful-convince-attempts / total-convince-attempts
end

to-report percentage-food-choices
  if total-destination-choices = 0 [
    report 0
  ]
  
  report 100 * food-choice-count / total-destination-choices
end

to-report percentage-drinks-choices
  if total-destination-choices = 0 [
    report 0
  ]
  
  report 100 * drinks-choice-count / total-destination-choices
end

to-report percentage-toilet-choices
  if total-destination-choices = 0 [
    report 0
  ]
  
  report 100 * toilet-choice-count / total-destination-choices
end

to-report percentage-stage-choices
  if total-destination-choices = 0 [
    report 0
  ]
  
  report 100 * stage-choice-count / total-destination-choices
end

to-report total-choice-percentage
  report percentage-food-choices + percentage-drinks-choices + percentage-toilet-choices + percentage-stage-choices
end

to-report number-of-food-choices
  report food-choice-count
end

to-report number-of-drinks-choices
  report drinks-choice-count
end

to-report number-of-toilet-choices
  report toilet-choice-count
end

to-report number-of-stage-choices
  report stage-choice-count
end

to-report number-of-destination-choices
  report total-destination-choices
end

to-report percentage-not-rejoined-at-end
  if not any? turtles [ report 0 ]
  report 100 * count turtles with [
    group-id = -1 or returning-to-group?
  ] / count turtles
end

to-report average-active-group-size
  let active-group-ids remove-duplicates
  [group-id] of turtles with [group-id != -1]
  
  if empty? active-group-ids [
    report 0
  ]
  
  let group-sizes []
  
  foreach active-group-ids [
    group ->
    set group-sizes lput
    (count turtles with [group-id = group])
    group-sizes
  ]
  
  report mean group-sizes
  
end

to-report number-of-active-groups
  let active-group-ids remove-duplicates
  [group-id] of turtles with [group-id != -1]

  report length active-group-ids
end

to apply-destination-scenario
  if destination-scenario = "sensitivity-analysis" [
  ]
  
  if destination-scenario = "baseline" [
    set food-increase 1
    set drinks-increase 3
    set stage-increase 4
    set toilet-increase 2
  ]
  
  if destination-scenario = "stage dominant" [
    set food-increase 1
    set drinks-increase 1
    set stage-increase 7
    set toilet-increase 1
  ]

  if destination-scenario = "stage-drinks" [
    set food-increase 1
    set drinks-increase 4
    set stage-increase 4
    set toilet-increase 1
  ]
  
  if destination-scenario = "practical needs" [
  set food-increase 3
  set drinks-increase 3
  set stage-increase 1
  set toilet-increase 3
]
end
]]></code>
